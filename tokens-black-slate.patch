+    --term-selection: rgb(255 149 0 / 0.3);
+    --term-black: #0b1212; --term-bright-black: #4f5e5e;
     --term-red: #b8242b; --term-bright-red: #d1453f;
     --term-green: #27702b; --term-bright-green: #3a8a3c;
-    --term-yellow: #8a5300; --term-bright-yellow: #a86a00;
