From edeb5ac2b784413b80410c6b217f64de4b615f6a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 01:32:45 +0000
Subject: [PATCH] Hub web: black dark theme and slate light theme tokens

Neutrals are no longer tinted toward the accent, which turned surfaces,
borders and muted text brown. Dark is true black with pure greys; light
is a mid slate grey. Orange stays the only warm colour, and in light mode
it is used only for fills, rules and underlines, never as text or a tint.
Every text token still passes 4.5:1 on every surface.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Fys117xMwAHcAd5xJDtTou
---
 hub/web/src/styles/tokens.css | 158 +++++++++++++++++-----------------
 1 file changed, 79 insertions(+), 79 deletions(-)

diff --git a/hub/web/src/styles/tokens.css b/hub/web/src/styles/tokens.css
index 1ce614d..d7348c9 100644
--- a/hub/web/src/styles/tokens.css
+++ b/hub/web/src/styles/tokens.css
@@ -7,44 +7,44 @@
 :root {
   color-scheme: dark;
 
-  /* ── Surfaces: warm CRT black, each step a little lighter ─────────── */
-  --bg:            #0f0d0b;  /* page */
-  --surface-1:     #161310;  /* panels, tables, tab strip */
-  --surface-2:     #1e1a16;  /* hover, raised rows, inputs */
-  --surface-3:     #28221c;  /* selected, pressed, menus */
-  --overlay:       rgb(5 4 3 / 0.72);  /* behind dialogs */
+  /* ── Surfaces: true black and pure grey. Neutrals are never tinted toward the orange ─────────── */
+  --bg:            #000000;  /* page */
+  --surface-1:     #0a0a0a;  /* panels, tables, tab strip */
+  --surface-2:     #121212;  /* hover, raised rows, inputs */
+  --surface-3:     #1c1c1c;  /* selected, pressed, menus */
+  --overlay:       rgb(0 0 0 / 0.72);  /* behind dialogs */
 
   /* ── Text ─────────────────────────────────────────────────────────── */
-  --text:          #f1e5d1;  /* 15.6:1 on bg */
-  --text-2:        #c4b29a;  /* 9.4:1  secondary */
-  --text-3:        #9a8a75;  /* 5.8:1  muted, timestamps; still AA */
-  --text-invert:   #1b1200;
+  --text:          #f5f5f5;  /* 16:1 on bg */
+  --text-2:        #b3b3b3;  /* 9:1  secondary */
+  --text-3:        #8a8a8a;  /* ≥4.5:1 on every surface: muted, timestamps */
+  --text-invert:   #000000;
 
   /* ── Borders ──────────────────────────────────────────────────────── */
-  --border:        #3a3128;  /* hairlines between rows (decorative) */
-  --border-strong: #75634f;  /* inputs, controls: ≥3:1 */
-
-  /* ── Accent: P3 amber phosphor ────────────────────────────────────── */
-  --accent:        #ffb000;  /* fills: primary buttons, active tab rule, cursor */
-  --accent-hover:  #ffc23d;
-  --accent-text:   #ffb000;  /* accent used as text/links on bg (10.6:1) */
-  --on-accent:     #1b1200;  /* text on accent fills (10.1:1) */
-  --accent-soft:   rgb(255 176 0 / 0.12);  /* selected row, active tab bg */
-  --accent-line:   rgb(255 176 0 / 0.45);
-  --focus:         #ffd27a;  /* focus ring, always 2px + 2px offset */
-  --brand:         #ffb000;  /* the logo is amber, the same phosphor as the UI */
-  --logo-front:    #ffb000;  /* front container */
-  --logo-prompt:   #0f0d0b;  /* the >_ knocked out of it */
-  --logo-line-1:   #7b5606;  /* back container outline */
-  --logo-line-2:   #c38703;  /* middle container outline */
+  --border:        #262626;  /* hairlines between rows (decorative) */
+  --border-strong: #6b6b6b;  /* inputs, controls: ≥3:1 */
+
+  /* ── Accent: orange. The only warm colour in the UI ────────────────────────────────────── */
+  --accent:        #ff9500;  /* fills: primary buttons, active tab rule, cursor */
+  --accent-hover:  #ffaa33;
+  --accent-text:   #ff9f1f;  /* accent used as text/links (≥9:1) */
+  --on-accent:     #140a00;  /* text on accent fills (9:1) */
+  --accent-soft:   rgb(245 245 245 / 0.08);  /* selected row bg: a neutral lift (an orange wash reads brown in dark, peach in light) */
+  --accent-line:   rgb(255 149 0 / 0.62);
+  --focus:         #ffc061;  /* focus ring, always 2px + 2px offset */
+  --brand:         #ff9500;  /* the logo's orange, same as the UI */
+  --logo-front:    #ff9500;  /* front container */
+  --logo-prompt:   #000000;  /* the >_ knocked out of it */
+  --logo-line-1:   #6b6b6b;  /* back container outline (neutral) */
+  --logo-line-2:   #b3b3b3;  /* middle container outline (neutral) */
 
   /* ── Status (each paired with a glyph; never colour alone) ─────────── */
   --status-running:      #7fd67f;  /* ● running / working */
   --status-running-soft: rgb(127 214 127 / 0.12);
   --status-waiting:      #5cc8ff;  /* ? waiting on a human answer */
   --status-waiting-soft: rgb(92 200 255 / 0.13);
-  --status-stopped:      #9a8a75;  /* ■ stopped / exited */
-  --status-stopped-soft: rgb(154 138 117 / 0.12);
+  --status-stopped:      #8a8a8a;  /* ■ stopped / exited */
+  --status-stopped-soft: rgb(138 138 138 / 0.12);
   --status-error:        #ff6464;  /* ✕ error / unhealthy / refused */
   --status-error-soft:   rgb(255 100 100 / 0.12);
   --status-unreachable:  #b99cff;  /* ⌁ engine unreachable (dashed outline) */
@@ -53,25 +53,25 @@
   --status-warn-soft:    rgb(245 215 110 / 0.12);
 
   /* ── Terminal theme (xterm.js ITheme; read at runtime, see docs) ──── */
-  --term-bg:          #0b0907;
-  --term-fg:          #ecdfc9;
-  --term-cursor:      #ffb000;
-  --term-cursor-accent: #0b0907;
-  --term-selection:   rgb(255 176 0 / 0.28);
-  --term-black:       #1e1a16;  --term-bright-black:   #6b5d4d;
+  --term-bg:          #000000;
+  --term-fg:          #f0f0f0;
+  --term-cursor:      #ff9500;
+  --term-cursor-accent: #000000;
+  --term-selection:   rgb(255 149 0 / 0.3);
+  --term-black:       #121212;  --term-bright-black:   #777777;
   --term-red:         #ff6b5e;  --term-bright-red:     #ff9a8f;
   --term-green:       #8fd18a;  --term-bright-green:   #b6e8a8;
   --term-yellow:      #ffc53d;  --term-bright-yellow:  #ffdd85;
   --term-blue:        #6fa8ff;  --term-bright-blue:    #9fc4ff;
   --term-magenta:     #d39cff;  --term-bright-magenta: #e6c2ff;
   --term-cyan:        #5cc8ff;  --term-bright-cyan:    #9edfff;
-  --term-white:       #d9cbb5;  --term-bright-white:   #fff6e6;
+  --term-white:       #cccccc;  --term-bright-white:   #ffffff;
 
-  /* ── Phosphor glow on amber rules (dark only; set to none to disable) ─ */
-  --glow-accent:   0 0 6px rgb(255 176 0 / 0.45);
+  /* ── Faint glow on orange rules (dark only; set to none to disable) ─ */
+  --glow-accent:   0 0 6px rgb(255 149 0 / 0.45);
 
   /* ── Elevation: borders, not shadows; one shadow for floating layers ─ */
-  --shadow-float:  0 10px 30px rgb(0 0 0 / 0.55), 0 0 0 1px var(--border);
+  --shadow-float:  0 10px 30px rgb(0 0 0 / 0.6), 0 0 0 1px var(--border);
 
   /* ── Type ─────────────────────────────────────────────────────────── */
   --font-mono:     "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
@@ -140,66 +140,66 @@
   --z-hud:    80;   /* leader-key overlay */
 }
 
-/* ── Light: "printout" — warm paper grey, ink text, the same amber keys ── */
+/* ── Light: mid slate grey, near-black text. Orange only as fills, rules and underlines, never as text or a tint ── */
