     --term-blue: #1f5fbf; --term-bright-blue: #3b78d4;
     --term-magenta: #8a3fb8; --term-bright-magenta: #a35ad0;
     --term-cyan: #09649a; --term-bright-cyan: #1a7fb8;
-    --term-white: #d6cdbf; --term-bright-white: #fbfaf7;
+    --term-white: #c6d0d0; --term-bright-white: #ffffff;
     --glow-accent: none;
-    --shadow-float: 0 10px 28px rgb(60 45 25 / 0.18), 0 0 0 1px var(--border);
+    --shadow-float: 0 10px 28px rgb(11 18 18 / 0.14), 0 0 0 1px var(--border);
   }
 }
