# Copy to .env. See docs/hub.md, "Example: Caddy and GitHub".

# The versions. To update one, change it here and run docker compose up -d. See README.md, "Updating".
EGZO_HUB_VERSION=0.14.2              # https://github.com/egzo-ai/egzo/releases
DEX_VERSION=v2.46.1                  # https://github.com/dexidp/dex/releases
CADDY_VERSION=2.11.7                 # https://github.com/caddyserver/caddy/releases (Caddy is built here: README.md)
CADDY_CLOUDFLARE_VERSION=v0.2.4      # https://github.com/caddy-dns/cloudflare/tags

# The host names. Each has a DNS record to this machine; the previews have a wildcard (*.egzo-preview.example.net), on a
# domain of their own.
EGZO_HUB_HOST=hub.example.com
EGZO_AUTH_HOST=auth.example.com
EGZO_PREVIEW_DOMAIN=egzo-preview.example.net

# Let's Encrypt: the account's email, and a Cloudflare API token for both zones: https://github.com/caddy-dns/cloudflare#configuration
ACME_EMAIL=
CLOUDFLARE_API_TOKEN=

# The GitHub OAuth app (GitHub, Settings, Developer settings, OAuth Apps), with the callback https://<EGZO_AUTH_HOST>/dex/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Members of this GitHub organization only. Empty: any GitHub account, which still needs an invite to get in.
GITHUB_ORG=

# Shared by the hub and Dex: openssl rand -hex 32
EGZO_OIDC_CLIENT_SECRET=

# The password sign-in, for the first start only: sign in as admin with this password and link GitHub to it. Then set
# EGZO_LOCAL_LOGIN=false, remove the password and run docker compose up -d again.
EGZO_LOCAL_LOGIN=true
EGZO_ADMIN_PASSWORD=
