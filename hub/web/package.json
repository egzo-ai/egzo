{
  "name": "egzo-hub-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The hub's web app: Svelte + TypeScript, built by Vite into ../internal/web/dist, which the hub binary embeds.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean.mjs && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "jsdom": "30.1.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
