# Copy to .env. Generate secrets with: openssl rand -hex 32
EGZO_SECRET_KEY=
EGZO_OIDC_CLIENT_SECRET=

# The addresses people reach the hub and Dex at, when not http://localhost:8080 and http://dex:5556/dex
# (for a first try on one machine, add "127.0.0.1 dex" to /etc/hosts)
# (also change `issuer` and `redirectURIs` in dex.yaml).
# EGZO_PUBLIC_URL=https://hub.example.com
# EGZO_OIDC_ISSUER=https://login.example.com/dex
# The reverse proxy whose X-Forwarded-* headers are believed (addresses or CIDRs).
# EGZO_TRUSTED_PROXIES=172.18.0.0/16

# The group id that owns /var/run/docker.sock.
# DOCKER_GID=
