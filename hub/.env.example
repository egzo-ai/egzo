# Copy to .env. Generate the secret key with: openssl rand -hex 32
EGZO_SECRET_KEY=

# The starter account's password (username: admin). Unset, the hub makes one and prints it once: docker compose logs hub.
# Setting it later resets it, which is also the way back in when it is lost.
# EGZO_ADMIN_PASSWORD=

# Single sign-on through your OpenID Connect provider (Keycloak, Authentik, Authelia, Google, Entra ID, ...). Register a client
# with the redirect address <EGZO_PUBLIC_URL>/auth/callback; the secret is optional for a public client.
# EGZO_OIDC_ISSUER=https://login.example.com/realms/main
# EGZO_OIDC_CLIENT_ID=egzo-hub
# EGZO_OIDC_CLIENT_SECRET=
# EGZO_OIDC_NAME=Keycloak
# Once an operator has linked their account at the provider, turn the password sign-in off:
# EGZO_LOCAL_LOGIN=false

# The address people reach the hub at, when not http://localhost:8080.
# EGZO_PUBLIC_URL=https://hub.example.com
# A reverse proxy whose X-Forwarded-* headers are believed (addresses or CIDRs).
# EGZO_TRUSTED_PROXIES=172.18.0.0/16

# The group id that owns /var/run/docker.sock.
# DOCKER_GID=
